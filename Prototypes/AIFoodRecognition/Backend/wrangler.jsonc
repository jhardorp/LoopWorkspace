{
  "name": "loop-plus-meal-review",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-2025-04-14",
    "DAILY_PHOTO_LIMIT": "10"
  },
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "PrototypeQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrototypeQuota"] }]
}
