index dd26c27..9295e2d 100644
--- a/LoopTests/ViewModels/BolusEntryViewModelTests.swift
+++ b/LoopTests/ViewModels/BolusEntryViewModelTests.swift
@@ -1070,3 +1070,129 @@ extension StoredGlucoseSample {
         StoredGlucoseSample(startDate: date, quantity: .glucose(value: value))
     }
 }
+
+// Experimental photo adapter regression tests. All storage and delivery delegates are mocks.
+#if MEAL_PHOTO_ADAPTER_TEST_HOST
+@MainActor
+final class MealPhotoMigrationTests: XCTestCase {
+    private final class Delegate: MockBolusEntryViewModelDelegate, CarbEntryViewModelDelegate {
+        var defaultAbsorptionTimes: DefaultAbsorptionTimes { LoopCoreConstants.defaultCarbAbsorptionTimes }
+        func isScheduleOverrideActive(at date: Date) -> Bool { false }
+        func getGlucoseSamples(start: Date?, end: Date?) async throws -> [StoredGlucoseSample] { [] }
+        func selectedFavoriteFoodLastEaten(_ food: StoredFavoriteFood) async throws -> Date? { nil }
+        func getFavoriteFoodCarbEntries(_ food: StoredFavoriteFood) async throws -> [StoredCarbEntry] { [] }
+        func getHistoricalChartsData(start: Date, end: Date) async throws -> HistoricalChartsData {
+            throw BolusEntryViewTestError.responseUndefined
+        }
+    }
+
+    private func meal() async throws -> MealPhotoTestReview {
+        try await MealPhotoTestReview.make()
+    }
+
+    func testReviewedValuesStayEditableWithoutSavingOrBolusNavigation() async throws {
+        let delegate = Delegate()
+        let vm = CarbEntryViewModel(delegate: delegate)
+        let time = vm.time, settings = delegate.settings
+        let reviewed = try await meal()
+        XCTAssertTrue(reviewed.apply(to: vm, request: vm.beginPhotoReview()))
+        XCTAssertEqual(vm.carbsQuantity, 12.5)
+        XCTAssertEqual(vm.absorptionTime, 5430)
+        XCTAssertEqual(vm.foodType, "Two large slices; banana not ripe")
+        XCTAssertTrue(vm.usesCustomFoodType)
+        XCTAssertTrue(vm.absorptionTimeWasEdited)
+        XCTAssertEqual(vm.time, time)
+        XCTAssertNil(vm.bolusViewModel)
+        XCTAssertTrue(delegate.carbEntriesAdded.isEmpty)
+        XCTAssertTrue(delegate.carbEntriesReplaced.isEmpty)
+        XCTAssertNil(delegate.enactedBolusUnits)
+        XCTAssertEqual(delegate.settings.maximumBolus, settings.maximumBolus)
+        vm.carbsQuantity = 15
+        vm.absorptionTime = 6000
+        vm.foodType = "Edited again"
+        XCTAssertEqual(vm.carbsQuantity, 15)
+        XCTAssertNil(vm.bolusViewModel)
+    }
+
+    func testDuplicateCallbackCannotOverwriteManualEdits() async throws {
+        let delegate = Delegate()
+        let vm = CarbEntryViewModel(delegate: delegate)
+        let request = vm.beginPhotoReview(), reviewed = try await meal()
+        XCTAssertTrue(reviewed.apply(to: vm, request: request))
+        vm.carbsQuantity = 20
+        XCTAssertFalse(reviewed.apply(to: vm, request: request))
+        XCTAssertEqual(vm.carbsQuantity, 20)
+        XCTAssertTrue(delegate.carbEntriesAdded.isEmpty)
+    }
+
+    func testCancellationAndOldPresentationLeaveEntryUntouched() async throws {
+        let delegate = Delegate()
+        let vm = CarbEntryViewModel(delegate: delegate)
+        vm.carbsQuantity = 22
+        vm.foodType = "Manual entry"
+        let reviewed = try await meal(), cancelled = vm.beginPhotoReview()
+        vm.cancelPhotoReview()
+        XCTAssertFalse(reviewed.apply(to: vm, request: cancelled))
+        let old = vm.beginPhotoReview(), current = vm.beginPhotoReview()
+        XCTAssertFalse(reviewed.apply(to: vm, request: old))
+        XCTAssertEqual(vm.carbsQuantity, 22)
+        XCTAssertEqual(vm.foodType, "Manual entry")
+        XCTAssertTrue(reviewed.apply(to: vm, request: current))
+        XCTAssertTrue(delegate.carbEntriesAdded.isEmpty)
+        XCTAssertNil(vm.bolusViewModel)
+    }
+
+    func testQueuedFavoriteChangesDoNotClobberReviewedValues() async throws {
+        let delegate = Delegate()
+        let vm = CarbEntryViewModel(delegate: delegate)
+        vm.favoriteFoods = [StoredFavoriteFood(name: "Favorite", carbsQuantity: LoopQuantity(unit: .gram, doubleValue: 70), foodType: "Favorite food", absorptionTime: 14400)]
+        vm.selectedFavoriteFoodIndex = 0
+        let reviewed = try await meal()
+        XCTAssertTrue(reviewed.apply(to: vm, request: vm.beginPhotoReview()))
+        try await Task.sleep(nanoseconds: 100_000_000)
+        XCTAssertEqual(vm.selectedFavoriteFoodIndex, -1)
+        XCTAssertEqual(vm.carbsQuantity, 12.5)
+        XCTAssertEqual(vm.absorptionTime, 5430)
+        XCTAssertEqual(vm.foodType, "Two large slices; banana not ripe")
+        XCTAssertNil(vm.bolusViewModel)
+    }
+
+    func testNativeLimitsRejectAtomicallyAndAllowCorrection() async throws {
+        let delegate = Delegate()
+        let vm = CarbEntryViewModel(delegate: delegate)
+        vm.carbsQuantity = 8
+        vm.foodType = "Keep me"
+        let request = vm.beginPhotoReview(), reviewed = try await meal()
+        vm.maxCarbEntryQuantity = LoopQuantity(unit: .gram, doubleValue: 10)
+        XCTAssertFalse(reviewed.apply(to: vm, request: request))
+        XCTAssertEqual(vm.carbsQuantity, 8)
+        XCTAssertEqual(vm.foodType, "Keep me")
+        vm.maxCarbEntryQuantity = LoopQuantity(unit: .gram, doubleValue: 250)
+        XCTAssertTrue(reviewed.apply(to: vm, request: request))
+        XCTAssertNil(vm.bolusViewModel)
+        XCTAssertTrue(delegate.carbEntriesAdded.isEmpty)
+    }
+    func testRepeatedReviewAndContinueKeepOneNewEntryIdentity() async throws {
+        let delegate = Delegate()
+        let vm = CarbEntryViewModel(delegate: delegate)
+        let reviewed = try await meal()
+        XCTAssertTrue(reviewed.apply(to: vm, request: vm.beginPhotoReview()))
+        vm.continueToBolus()
+        for _ in 0..<100 where vm.bolusViewModel == nil { try await Task.sleep(nanoseconds: 10_000_000) }
+        let first = try XCTUnwrap(vm.bolusViewModel?.carbEntryChange)
+        guard case .add(let firstEntry) = first else { return XCTFail("Expected new entry") }
+        vm.bolusViewModel = nil
+        XCTAssertTrue(reviewed.apply(to: vm, request: vm.beginPhotoReview()))
+        vm.carbsQuantity = 20
+        vm.continueToBolus()
+        for _ in 0..<100 where vm.bolusViewModel == nil { try await Task.sleep(nanoseconds: 10_000_000) }
+        let second = try XCTUnwrap(vm.bolusViewModel?.carbEntryChange)
+        guard case .add(let secondEntry) = second else { return XCTFail("Expected new entry") }
+        XCTAssertEqual(firstEntry.syncIdentifier, secondEntry.syncIdentifier)
+        XCTAssertEqual(secondEntry.quantity.doubleValue(for: .gram), 20)
+        XCTAssertTrue(delegate.carbEntriesAdded.isEmpty)
+        XCTAssertNil(delegate.enactedBolusUnits)
+    }
+
+}
+#endif
