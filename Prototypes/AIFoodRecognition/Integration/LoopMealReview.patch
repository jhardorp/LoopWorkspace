+    func applyPhotoReview(carbohydrateGrams: Double, absorptionMinutes: Double, foodDescription: String) -> Bool {
+        guard carbohydrateGrams.isFinite, absorptionMinutes.isFinite,
+              0...maxCarbEntryQuantity.doubleValue(for: preferredCarbUnit) ~= carbohydrateGrams,
+              absorptionRimesRange.contains(absorptionMinutes * 60) else { return false }
+
+        // Cancel queued favorite changes before clearing the selection; they must not overwrite the review.
+        favoriteFoodIndexObserver?.cancel()
+        selectedFavoriteFoodIndex = -1
+        selectedDefaultAbsorptionTimeEmoji = ""
+        carbsQuantity = carbohydrateGrams
+        foodType = foodDescription
+        usesCustomFoodType = true
+        absorptionTime = absorptionMinutes * 60
+        absorptionTimeWasEdited = true
+        observeFavoriteFoodIndexChange()
+        return true
+    }
