require 'base64'
require 'json'

import File.join(ENV.fetch('GITHUB_WORKSPACE'), 'fastlane', 'Fastfile')
import File.expand_path('../upload.fastlane.rb', __dir__)

platform :ios do
  lane :prepare_candidate do
    UI.user_error!('Migration Actions required') unless ENV['GITHUB_ACTIONS'] == 'true' &&
      ENV['GITHUB_REPOSITORY'] == 'jhardorp/LoopWorkspace' &&
      ENV['GITHUB_REF'] == 'refs/heads/migration/loop4-ai-photo' && ENV['TEAMID'] == '279LYMG57A'
    root = ENV.fetch('GITHUB_WORKSPACE')
    proof = JSON.parse(File.read(File.join(ENV.fetch('RUNNER_TEMP'), 'NextValidation.json')))
    UI.user_error!('Validation proof does not match this checkout') unless
      proof.fetch('candidate_source') == ENV.fetch('GITHUB_SHA') && proof.fetch('application_source_unchanged') == true
    main = File.read(File.join(root, 'Loop/Loop/main.swift'))
    UI.user_error!('Cannot archive a generated test host') unless
      main.include?('NSStringFromClass(AppDelegate.self)') && !main.include?('MealPhotoAdapterTestAppDelegate')
    api_key = app_store_connect_api_key(key_id: ENV.fetch('FASTLANE_KEY_ID'),
                                      issuer_id: ENV.fetch('FASTLANE_ISSUER_ID'), key_content: ENV.fetch('FASTLANE_KEY'))
    app = Spaceship::ConnectAPI::App.find('com.279LYMG57A.loopkit.Loop')
    UI.user_error!('Existing app identity mismatch') unless app && app.id == '6737123014'
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: app.bundle_id)
    UI.user_error!('Existing app history changed; expected build 27') unless latest.to_i == 27
    ENV['MATCH_READONLY'] = 'true'
    ENV['GYM_XCARGS'] = '-onlyUsePackageVersionsFromResolvedFile'
    authorization = Base64.strict_encode64("#{ENV.fetch('GITHUB_REPOSITORY_OWNER')}:#{ENV.fetch('GH_PAT')}")
    puts "::add-mask::#{authorization}"
    Dir.chdir(File.join(root, 'fastlane')) { build_loop }
    UI.user_error!('Signed archive is missing') unless File.file?(File.join(root, 'Loop.ipa'))
    UI.success('Prepared the normal-identity candidate using existing read-only signing. No upload or installation.')
  end
end
